# Server Port (Railway will provide this automatically, default 3001)
PORT=3001

# High-traffic tuning (Keep 0 and 1 on Railway / Containers)
CLUSTER=0
WORKERS=1
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=50000

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL) Database URL
# ---------------------------------------------------------------------------
# Get connection string from: Supabase Project Settings -> Database -> Connection string URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API keys (Supabase Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret for admin authentication
JWT_SECRET=telugu_icon_awards_secret_key_2024_very_secure
JWT_EXPIRES_IN=24h

# Frontend origin allowed to access API (* allows any domain, or set to your Vercel URL)
FRONTEND_URL=*

# MSG91 OTP settings (optional for live SMS)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY=10
